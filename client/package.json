{
  "name": "gca-client",
  "version": "0.3.0",
  "description": "GCA — Global Control Assistant device client (MCP server + 20 tools + approval system + CLI)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gca": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --test --import tsx \"src/**/*.test.ts\"",
    "test:e2e": "node tests/e2e-test.mjs",
    "setup:pairing": "tsx scripts/setup-pairing.ts",
    "gca": "tsx src/cli.ts",
    "pair": "tsx src/cli.ts pair",
    "pair-init": "tsx src/cli.ts pair-init",
    "server:dev": "tsx ../server/src/gca-server.ts",
    "server:start": "node ../server/dist/gca-server.js",
    "server:setup": "tsx ../server/src/cli.ts setup"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^4.21.0",
    "pino": "^10.3.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}