# GCA POC Configuration

# Port the MCP Server listens on (OpenClaw connects to this)
PORT=3001

# Device name shown to OpenClaw Gateway
DEVICE_NAME=home-pc

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Command execution timeout in milliseconds
EXEC_TIMEOUT=30000

# Maximum output size in bytes (prevents huge output from crashing the server)
EXEC_MAX_OUTPUT=1048576
