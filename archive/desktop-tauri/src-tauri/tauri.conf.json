{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GCA Desktop",
  "version": "0.3.0",
  "identifier": "com.gca.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "GCA - Global Control Assistant",
        "width": 640,
        "height": 480,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://<网关IP>:18790 http://<Android设备IP>:3003 http://127.0.0.1:3002; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    },
    "trayIcon": null
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/node.exe",
      "resources/gca-bundle.cjs"
    ]
  }
}
