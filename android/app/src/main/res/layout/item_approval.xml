<?xml version="1.0" encoding="utf-8"?>
<!-- 单条审批卡（2026-08-14 卡片流）：左右滑动切换 / 上滑通过 / 下滑拒绝 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="审批请求"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/card_device"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="16sp"
        android:text="设备：-" />

    <TextView
        android:id="@+id/card_operation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="15sp"
        android:text="请求：-" />

    <TextView
        android:id="@+id/card_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="13sp"
        android:textColor="#666666"
        android:text="详情：-" />

    <TextView
        android:id="@+id/card_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="12sp"
        android:textColor="#999999"
        android:text="时间：-" />

    <TextView
        android:id="@+id/card_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="12sp"
        android:textColor="#888888"
        android:gravity="center"
        android:text="上滑下一条 · 左滑同意 · 右滑拒绝" />

    <Button
        android:id="@+id/card_approve"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="授权"
        android:textSize="16sp" />

    <Button
        android:id="@+id/card_reject"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:text="拒绝"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/card_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
